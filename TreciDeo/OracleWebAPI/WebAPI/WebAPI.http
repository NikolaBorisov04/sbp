@WebAPI_HostAddress = https://localhost:7234
@JsonContentType = application/json

### VOZILA

### Vratice sva vozila
GET {{WebAPI_HostAddress}}/api/vozila/sve

### Vratice jedno vozilo po ID-ju
GET {{WebAPI_HostAddress}}/api/vozila/44

### Kreiraj novo vozilo - ELEKTRICNO VOZILO
POST {{WebAPI_HostAddress}}/api/vozila
Content-Type: {{JsonContentType}}

{
  "registarskaOznaka": "NS-001-KX",
  "vin": "VIN123456789ABC01",
  "marka": "Tesla",
  "model": "Model 3",
  "godinaProizvodnje": 2023,
  "datumNabavke": "2023-06-15",
  "status": "Dostupno",
  "brojSedista": 5,
  "stanjeEnterijera": "Odlicno",
  "stanjeEksterijera": "Odlicno",
  "ogranicenjaKoriscenja": null,
  "tipKoriscenjaId": 1,
  "tipPogonaId": 1,
  "kapacitetBaterije": 75.0,
  "trenutniNivoNapunjenosti": 100.0,
  "autonomija": 500,
  "tipPunjenja": "DC",
  "brojCiklusaPunjenja": 0,
  "tipHibridnogPogona": "",
  "tipGoriva": "",
  "zapreminaRezervoara": 0.0,
  "prosecnaPotrosnja": 0.0
}

