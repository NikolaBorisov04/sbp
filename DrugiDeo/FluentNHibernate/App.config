<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!--
    LOCAL DATABASE CONFIGURATION

    Do not put real credentials in GitHub.
    Replace the placeholder values on your local machine.

    The application reads this connection string from the name "OracleCS"
    inside DataLayer.cs.
  -->
  <connectionStrings>
    <add name="OracleCS"
         connectionString="Data Source=YOUR_ORACLE_HOST:1521/YOUR_SERVICE;User Id=YOUR_USER;Password=YOUR_PASSWORD" />
  </connectionStrings>
</configuration>
